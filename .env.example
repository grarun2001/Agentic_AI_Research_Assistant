# ================================================================
# Agentic AI Research Assistant Environment Configuration
# ================================================================

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# External Research Tool (Tavily Web Search)
TAVILY_API_KEY=your_tavily_api_key_here

# Milvus Vector Database Configuration
# Use 'http://localhost:19530' for Milvus Docker standalone
MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agentic_rag_documents

# Embeddings & Reranking Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Retrieval & RRF Hyperparameters
SEMANTIC_TOP_K=10
KEYWORD_TOP_K=10
HYBRID_TOP_K=8
RRF_K=60

# Ingestion & Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# Storage Paths
DATA_DIR=data
DOCUMENTS_DIR=data/documents
INDEX_FILE=data/index/chunks.json

# Reliability Layer / Circuit Breakers
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=45
MAX_RETRIES=2
INITIAL_BACKOFF_SECONDS=1.0

# API & Service Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
